{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "AllowedHosts": [
      "localhost",
      "orders.localhost",
      "inventory.localhost",
      "notifications.localhost",
      "ui.localhost"
    ],
    "AllowedOrigins": [
      "http://localhost:5022",
      "http://localhost:5173",
      "http://localhost:5032",
      "http://localhost:5042",
      "https://localhost:5023",
      "https://localhost:5174",
      "https://localhost:5033",
      "https://localhost:5043"
    ],
    "MaxRequestBodySizeBytes": 1048576
  },
  "ReverseProxy": {
    "Routes": {
      "orders-api-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/{**catch-all}",
          "Hosts": [ "orders.localhost", "localhost" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}",
          "Hosts": [ "inventory.localhost", "localhost" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/inventory" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}",
          "Hosts": [ "notifications.localhost", "localhost" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/notifications" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "ui-route": {
        "ClusterId": "ui-cluster",
        "Match": {
          "Path": "/app/{**catch-all}",
          "Hosts": [ "ui.localhost", "localhost" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/app" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "orders-primary": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-primary": {
            "Address": "http://localhost:5011"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-primary": {
            "Address": "http://localhost:5012"
          }
        }
      },
      "ui-cluster": {
        "Destinations": {
          "ui-primary": {
            "Address": "http://localhost:5173"
          }
        }
      }
    }
  },
  "IdentityProvider": {
    "Enabled": false,
    "Mode": "KeycloakLocal",
    "Authority": "http://localhost:8081/realms/xy-phase9",
    "Audience": "xy-order-processing",
    "Scheme": "Bearer",
    "Scope": "local-only-proof"
  }
}
