{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "AllowedHosts": [
      "localhost",
      "orders.localhost",
      "payments.localhost",
      "inventory.localhost",
      "notifications.localhost",
      "ui.localhost"
    ],
    "AllowedOrigins": [
      "http://localhost:5022",
      "http://localhost:5173",
      "http://localhost:5032",
      "http://localhost:5042",
      "https://localhost:5023",
      "https://localhost:5174",
      "https://localhost:5033",
      "https://localhost:5043"
    ],
    "MaxRequestBodySizeBytes": 1048576
  },
  "ReverseProxy": {
    "Routes": {
      "orders-api-route": {
        "ClusterId": "orders-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "payments-api-route": {
        "ClusterId": "payments-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v{version}/Payments/{**catch-all}"
        }
      },
      "payments-webhook-route": {
        "ClusterId": "payments-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v{version}/webhook/{**catch-all}"
        }
      },
      "payments-callback-route": {
        "ClusterId": "payments-cluster",
        "Order": 10,
        "Match": {
          "Path": "/payment/{**catch-all}"
        }
      },
      "payments-callback-result-route": {
        "ClusterId": "payments-cluster",
        "Order": 10,
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },
      "inventory-api-route": {
        "ClusterId": "inventory-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v{version}/Inventory/{**catch-all}"
        }
      },
      "product-api-route": {
        "ClusterId": "inventory-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v{version}/Product/{**catch-all}"
        }
      },
      "notifications-api-route": {
        "ClusterId": "notifications-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v{version}/Notifications/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/inventory" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/notifications" }
        ]
      },
      "ui-route": {
        "ClusterId": "ui-cluster",
        "Match": {
          "Path": "/app/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/app" }
        ]
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "orders-primary": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payments-primary": {
            "Address": "http://localhost:5084"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-primary": {
            "Address": "http://localhost:5011"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-primary": {
            "Address": "http://localhost:5012"
          }
        }
      },
      "ui-cluster": {
        "Destinations": {
          "ui-primary": {
            "Address": "http://localhost:5173"
          }
        }
      }
    }
  },
  "IdentityProvider": {
    "Enabled": false,
    "Mode": "KeycloakLocal",
    "Authority": "http://localhost:8081/realms/xy-phase9",
    "Audience": "xy-order-processing",
    "Scheme": "Bearer",
    "Scope": "local-only-proof"
  }
}
