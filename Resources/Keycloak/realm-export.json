{
  "realm": "xy-phase9",
  "enabled": true,
  "displayName": "XY Order Processing Local",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "clients": [
    {
      "clientId": "xy-order-processing-local-web",
      "name": "XY Order Processing Local Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://localhost:5174/*",
        "http://localhost:5022/*",
        "https://localhost:5023/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://localhost:5174",
        "http://localhost:5022",
        "https://localhost:5023"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/signed-out##https://localhost:5174/signed-out##http://localhost:5022/signed-out##https://localhost:5023/signed-out"
      },
      "protocolMappers": [
        {
          "name": "order-processing-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "xy-order-processing",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_code",
            "claim.name": "tenant_code",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "xy-order-processing-backend",
      "name": "XY Order Processing Backend",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_BACKEND_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "frontchannelLogout": false,
      "webOrigins": [
        "+"
      ]
    }
  ],
  "users": [
    {
      "username": "tenant-a-user", "enabled": true, "emailVerified": true,
      "email": "tenant-a-user@example.local", "firstName": "Tenant A", "lastName": "User",
      "attributes": { "tenant_code": ["TenantA"] },
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_TENANT_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["offline_access", "tenant-user"]
    },
    {
      "username": "tenant-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant-admin@example.local",
      "firstName": "Tenant",
      "lastName": "Admin",
      "attributes": {
        "tenant_code": [
          "TenantA"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TENANT_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "tenant-admin",
        "platform-admin",
        "phase10-operator"
      ]
    },
    {
      "username": "tenant-user",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant-user@example.local",
      "firstName": "Tenant",
      "lastName": "User",
      "attributes": {
        "tenant_code": [
          "TenantA"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TENANT_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "tenant-user"
      ]
    },
    {
      "username": "tenant-b-user",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant-b-user@example.local",
      "firstName": "Tenant B",
      "lastName": "User",
      "attributes": {
        "tenant_code": [
          "TenantB"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TENANT_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "tenant-user"
      ]
    },
    {
      "username": "tenant-c-user",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant-c-user@example.local",
      "firstName": "Tenant C",
      "lastName": "User",
      "attributes": {
        "tenant_code": [
          "TenantC"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TENANT_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "tenant-user"
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Explicit access to all active application tenants; does not bypass tenant isolation." },
      {
        "name": "tenant-admin",
        "description": "Local tenant administrator role"
      },
      {
        "name": "tenant-user",
        "description": "Local tenant user without operations privileges"
      },
      {
        "name": "phase10-operator",
        "description": "Allows explicit approval of quarantined Phase 10 messages"
      }
    ]
  }
}
