# Copy this file to .env.local on your machine and set local-only Docker secrets.
# The real .env.local file is gitignored.
LOCAL_SQL_PASSWORD=<set-a-local-docker-sql-password>
LOCAL_CERT_PASSWORD=<set-a-local-https-certificate-password>
LOCAL_OPENPAY_MERCHANT_ID=<set-a-local-openpay-merchant-id>
LOCAL_OPENPAY_PUBLIC_KEY=<set-a-local-openpay-public-key>
LOCAL_OPENPAY_PRIVATE_KEY=<set-a-local-openpay-private-key>
LOCAL_OPENPAY_DEVICE_SESSION_ID=<set-a-local-openpay-device-session-id>
LOCAL_RAZORPAY_MERCHANT_ID=<set-a-local-razorpay-merchant-id>
LOCAL_RAZORPAY_PRIVATE_KEY=<set-a-local-razorpay-private-key>
LOCAL_RAZORPAY_WEBHOOK_SECRET=<set-a-local-razorpay-webhook-secret>
LOCAL_OPENPAY_WEBHOOK_SECRET=<set-a-local-openpay-webhook-secret>
KEYCLOAK_TENANT_ADMIN_PASSWORD=<set-a-local-keycloak-tenant-admin-password>

# Local emulator configuration. These are development-only values.
LOCAL_AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFeqCnf2fflL1GTfJn0fr6FHBpiHXUrJ68KGSYE8CN6bH4Zw8sF6Rmhwbqn4RjD3FFaA==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
LOCAL_AZURITE_HOST_CONNECTION_STRING=UseDevelopmentStorage=true
LOCAL_SERVICEBUS_ENABLED=false
LOCAL_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
LOCAL_SERVICEBUS_HOST_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
LOCAL_SERVICEBUS_TOPIC_NAME=order-events
LOCAL_SERVICEBUS_INVENTORY_SUBSCRIPTION_NAME=inventory-order-created
LOCAL_SERVICEBUS_NOTIFICATIONS_SUBSCRIPTION_NAME=notifications-order-created
LOCAL_SERVICEBUS_DLQ_TOPIC_NAME=order-events-dlq
LOCAL_SERVICEBUS_DLQ_SUBSCRIPTION_NAME=dlq-replay
LOCAL_SERVICEBUS_REPLAY_ENABLED=true
SERVICEBUS_EMULATOR_ACCEPT_EULA=N
SERVICEBUS_EMULATOR_SQL_PASSWORD=<set-a-local-servicebus-emulator-sql-password>

# Optional: override when Docker/Testcontainers should use a pre-pulled or mirrored SQL Server image.
ORDERPROCESSING_SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU14-ubuntu-22.04
AZURITE_IMAGE=xydatalabs/phase10-azurite:3.35.0-local
AZURITE_NPM_VERSION=3.35.0
SERVICEBUS_EMULATOR_IMAGE=mcr.microsoft.com/azure-messaging/servicebus-emulator:1.1.2
SERVICEBUS_EMULATOR_SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU14-ubuntu-22.04
