{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderProcessingSystemDbConnection": "Server=localhost,1433;Database=OrderProcessingSystem_Local;User Id=sa;Password=Admin100@;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true;",
    "TenantRegistryDbConnection": "Server=localhost,1433;Database=OrderProcessingSystem_Local;User Id=sa;Password=Admin100@;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "DedicatedTenantConnectionStrings": {
    "TenantC": "Server=localhost,1433;Database=OrderProcessingSystem_TenantC;User Id=sa;Password=Admin100@;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "Webhooks": {
    "Razorpay": {
      "Secret": "__RAZORPAY_WEBHOOK_SECRET__"
    },
    "OpenPay": {
      "Secret": "__OPENPAY_WEBHOOK_SECRET__"
    }
  },
  "OpenPay": {
    "MerchantId": "__OPENPAY_MERCHANT_ID__",
    "PublicKey": "__OPENPAY_PUBLIC_KEY__",
    "PrivateKey": "__OPENPAY_PRIVATE_KEY__",
    "DeviceSessionId": "__OPENPAY_DEVICE_SESSION_ID__",
    "IsProduction": false,
    "RedirectUrl": ""
  },
  "Razorpay": {
    "MerchantId": "__RAZORPAY_MERCHANT_ID__",
    "PrivateKey": "__RAZORPAY_PRIVATE_KEY__",
    "IsProduction": false
  },
  "PaymentProviders": {
    "UseDeterministicAdapters": true
  },
  "Observability": {
    "EnableEfSensitiveDataLogging": true
  },
  "TenantConfiguration": {
    "ActiveTenantCode": "TenantA",
    "UiSelectorEnabled": true,
    "UiTenantOverrideEnabled": true,
    "SwaggerSelectorEnabled": true
  },
  "IdentityProvider": {
    "Enabled": true,
    "Mode": "KeycloakLocal",
    "Authority": "http://localhost:8081/realms/xy-phase9",
    "Audience": "xy-order-processing",
    "Scheme": "Bearer",
    "Scope": "local-only-proof",
    "ClientId": "xy-order-processing-backend",
    "ClientSecret": "__KEYCLOAK_BACKEND_CLIENT_SECRET__"
  },
  "Frontend": {
    "WebBaseUrl": "http://localhost:5173"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/webapi-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{TraceId}] {Level:u3} {Username} {Message:lj}{Exception}{NewLine}"
        }
      }
    ]
  },
  "ApiSettings": {
    "UI": {
      "http": {
        "Host": "localhost",
        "Port": 5173,
        "HttpsEnabled": false
      },
      "https": {
        "Host": "localhost",
        "Port": 5174,
        "HttpsEnabled": true,
        "CertPassword": "__CERT_PASSWORD__",
        "CertPath": "/https/aspnetapp.pfx"
      }
    },
    "API": {
      "http": {
        "Host": "localhost",
        "Port": 5010,
        "HttpsEnabled": false
      },
      "https": {
        "Host": "localhost",
        "Port": 5011,
        "HttpsEnabled": true,
        "CertPassword": "__CERT_PASSWORD__",
        "CertPath": "/https/aspnetapp.pfx"
      }
    }
  },
  "LaunchSettings": {
    "Environment": "Development",
    "DefaultProfile": "http",
    "LaunchBrowser": true,
    "HotReloadEnabled": true,
    "API": {
      "LaunchUrl": "swagger",
      "EnvironmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "CORS_ALLOWED_ORIGINS": "http://localhost:5173;https://localhost:5174"
      }
    },
    "UI": {
      "EnvironmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "API_BASE_URL": "http://localhost:5010"
      }
    }
  },
  "Azure": {
    "Local": {
      "Enabled": true,
      "ConnectionStrings": {
        "DefaultConnection": "Server=localhost,1433;Database=OrderProcessingSystem_Local;User Id=sa;Password=Admin100@;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true;",
        "Redis": "localhost:6379"
      }
    },
    "Cloud": {
      "Enabled": false
    }
  },
  "Docker": {
    "Networks": {
      "Name": "xy-dev-network",
      "Subnet": "172.20.0.0/16",
      "Gateway": "172.20.0.1"
    },
    "Volumes": {
      "Database": {
        "Name": "orderprocessing_db_dev",
        "Persistent": true
      },
      "Logs": {
        "Name": "orderprocessing_logs_dev", 
        "Persistent": true
      }
    }
  }
}
