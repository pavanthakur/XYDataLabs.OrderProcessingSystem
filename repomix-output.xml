        type.GetProperty("BillingCustomerId").Should().NotBeNull(
            because: "CardTransaction.BillingCustomerId is the FK to BillingCustomers (renamed from CustomerId in fix 1)");

        type.GetProperty("CustomerId").Should().BeNull(
