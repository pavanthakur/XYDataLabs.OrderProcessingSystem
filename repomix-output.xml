}

.action-button-primary {
  background: #132238;
  color: #f7f4ef;
}

.action-button-primary:hover {
  background: #1d3554;
}

.panel-header {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  justify-content: space-between;
}

.detail-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.tenant-picker {
  display: grid;
  gap: 6px;
  min-width: 210px;
}

.tenant-picker select {
  border: 1px solid rgba(19, 34, 56, 0.16);
  border-radius: 12px;
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.92);
}

.definition-list {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 24px 0 0;
}

.definition-list-compact {
  margin-top: 18px;
}

.definition-list div,
.customer-list li {
  border-radius: 18px;
  background: rgba(243, 246, 251, 0.92);
}

.definition-list div {
  padding: 14px 16px;
}

.definition-list dt {
  font-size: 0.85rem;
}

.definition-list dd {
  margin: 6px 0 0;
  font-weight: 700;
}

.count-pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 8px 12px;
  background: rgba(255, 201, 130, 0.3);
  font-size: 0.9rem;
}

.customer-list {
  list-style: none;
  padding: 0;
  margin: 24px 0 0;
  display: grid;
  gap: 12px;
}

.customer-list li {
  padding: 0;
}

.customer-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  padding: 16px;
  color: inherit;
  text-decoration: none;
}

.customer-link:hover {
  background: rgba(255, 201, 130, 0.18);
}

.order-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  color: inherit;
  text-decoration: none;
}

.order-link:hover {
  color: inherit;
}

.customer-list strong {
  display: block;
  font-size: 1rem;
}

.customer-list p {
  margin: 4px 0 0;
  font-size: 0.92rem;
}

.empty-state {
  margin: 24px 0 0;
  color: rgba(19, 34, 56, 0.7);
}

.detail-layout {
  display: block;
}

.detail-grid {
  grid-template-columns: 1.4fr 0.9fr;
  margin-top: 24px;
}

.detail-card {
  border-radius: 18px;
  background: rgba(243, 246, 251, 0.92);
  padding: 18px;
}

.detail-card h3 {
  margin: 0 0 14px;
}

.payment-header-copy {
  display: grid;
  gap: 10px;
  max-width: 64ch;
}

.form-section {
  display: grid;
  gap: 14px;
}

.form-section + .form-section {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid rgba(19, 34, 56, 0.08);
}

.section-kicker {
  margin: 0;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #9c4f19;
}

.payment-trust-copy {
  padding-top: 2px;
}

.technical-details {
  margin-top: 18px;
  border-radius: 18px;
  border: 1px solid rgba(19, 34, 56, 0.12);
  background: rgba(255, 255, 255, 0.52);
  padding: 16px 18px;
}

.technical-details summary {
  cursor: pointer;
  font-weight: 600;
  color: rgba(19, 34, 56, 0.86);
}

.technical-details-list {
  margin-top: 14px;
}

.result-panel {
  margin-top: 18px;
}

.callback-layout {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 18px;
  margin-top: 24px;
}

.loading-progress-panel {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.loading-progress-panel strong {
  display: block;
}

.loading-progress-panel p {
  margin: 6px 0 0;
}

