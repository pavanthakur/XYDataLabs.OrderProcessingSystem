| order by timestamp asc
"@ -f (Get-KqlQuotedValues -Values $expectedUiTenants)

        $fallbackUiRows = Convert-AppInsightsRows -Response (Invoke-AppInsightsQuery -Query $fallbackUiQuery)
        $fallbackUiEvents = @(
            foreach ($row in $fallbackUiRows) {
