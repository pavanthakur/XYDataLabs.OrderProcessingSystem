  height: 18px;
  flex: 0 0 18px;
  margin-top: 2px;
  border-radius: 999px;
  border: 2px solid rgba(19, 34, 56, 0.18);
  border-top-color: rgba(19, 34, 56, 0.72);
  animation: callback-spin 0.9s linear infinite;
}

@keyframes callback-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.callback-debug-list {
  list-style: none;
  padding: 0;
  margin: 16px 0 0;
  display: grid;
  gap: 10px;
}

.callback-debug-list li {
  padding-top: 10px;
  border-top: 1px solid rgba(19, 34, 56, 0.08);
}

.callback-debug-list li:first-child {
