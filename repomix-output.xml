  border-top: 0;
}

.callback-debug-list span {
  display: block;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(19, 34, 56, 0.52);
}

.callback-debug-list strong {
  display: block;
  margin-top: 4px;
  word-break: break-word;
}

.payment-layout {
  display: grid;
  grid-template-columns: 1.25fr 0.85fr;
  gap: 18px;
  margin-top: 24px;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.field-span-full {
  grid-column: 1 / -1;
}

.order-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 12px;
}

.order-list li {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  border-top: 1px solid rgba(19, 34, 56, 0.08);
}

.order-list li:first-child {
  border-top: 0;
  padding-top: 0;
}

.order-meta {
  display: grid;
  gap: 4px;
  text-align: right;
}

.subtle-copy {
  margin: 0;
}

.order-create-layout {
  display: grid;
  grid-template-columns: 1.4fr 0.9fr;
  gap: 18px;
  margin-top: 24px;
}

.order-summary-card {
  display: grid;
  align-content: start;
  gap: 18px;
}

.definition-list-single {
  grid-template-columns: 1fr;
}

.selection-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 12px;
}

.selection-list-compact {
  gap: 10px;
}

.selection-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 16px;
  border-radius: 18px;
  background: rgba(243, 246, 251, 0.92);
  border: 1px solid transparent;
  cursor: pointer;
}

.selection-card input {
  margin-top: 4px;
}

.selection-card-selected {
  border-color: rgba(156, 79, 25, 0.35);
  background: rgba(255, 201, 130, 0.2);
}

.selection-card-static {
  cursor: default;
}

.selection-card strong {
  display: block;
}

.selection-card p {
  margin: 4px 0 0;
  color: rgba(19, 34, 56, 0.68);
}

@media (max-width: 900px) {
  .shell-header,
  .status-grid,
  .workspace-grid,
  .definition-list,
  .detail-grid,
  .order-create-layout,
  .callback-layout,
  .payment-layout,
  .field-grid {
    grid-template-columns: 1fr;
  }

  .panel-header {
    flex-direction: column;
  }

  .shell-actions,
  .search-form,
  .search-actions,
  .detail-actions {
    width: 100%;
  }

  .tenant-picker {
    width: 100%;
  }

  .customer-link,
  .order-list li,
  .order-link,
  .selection-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .order-meta {
    text-align: left;
  }
}

.redirect-transition-card {
  display: grid;
  gap: 18px;
  margin-top: 24px;
}

.redirect-transition-list {
  margin-top: 0;
}
