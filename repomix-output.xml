      expectOidcHandoff:
        description: 'Internal use only — fail if parent workflow expected to hand off OIDC values but none arrived'
        required: false
        type: boolean
        default: false
  workflow_call:
    inputs:
      environment:
        description: 'Target Environment'
        required: true
        type: string
