  padding: 12px 14px;
  background: rgba(255, 255, 255, 0.92);
}

.search-actions {
  display: flex;
  gap: 10px;
}

.action-button {
  border: 0;
  border-radius: 999px;
  padding: 12px 18px;
  cursor: pointer;
  background: rgba(243, 246, 251, 0.92);
  color: #132238;
