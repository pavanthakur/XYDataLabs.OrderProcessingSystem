                        $_.ResolvedRunPrefix -eq $selectedRunPrefix -or
                        $_.ResolvedCustomerOrderId -like "$selectedRunPrefix*" -or
                        ($allDbChargeIds -contains $_.ChargeId)
                    } |
                    Sort-Object Timestamp
            )

            if ($selectedApiEvents.Count -eq 0) {
