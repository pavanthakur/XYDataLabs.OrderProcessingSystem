{
  "name": "@xydatalabs/payment-automation",
  "private": true,
  "version": "0.0.0-placeholder",
  "type": "module",
  "scripts": {
    "report:phase10-preview": "tsx src/cli/render-phase10-preview.ts",
    "verify:phase10-completion": "tsx src/cli/verify-phase10-completion.ts",
    "reconcile:phase10-acceptance": "tsx src/cli/reconcile-phase10-acceptance.ts",
    "test:phase10-acceptance": "tsx --test src/report/phase10-acceptance.test.ts",
    "test:phase10-report": "tsx --test src/report/phase10-report.test.ts",
    "test:hosted-ci-contract": "node --test ../scripts/tests/hosted-ci-contract.test.mjs",
    "test:payment-currency:browser": "tsx --test src/browser/payment-currency.browser.test.ts",
    "test:order-continuation:browser": "tsx --test src/browser/order-payment-continuation.browser.test.ts",
    "test:payment-evidence": "tsx --test src/browser/payment-evidence.test.ts",
    "test:acceptance-coverage": "tsx --test src/cli/payment-acceptance-coverage.test.ts",
    "test:verification-polling": "tsx --test src/verification/verification-polling.test.ts",
    "test:provider-challenges:browser": "tsx --test src/browser/provider-challenge.browser.test.ts",
    "test:payments:sandbox": "tsx src/cli/run-payment-acceptance.ts",
    "test:payments:sandbox:negative": "tsx src/cli/run-payment-acceptance.ts --negative",
    "test:payments:deterministic": "tsx src/cli/run-payment-acceptance.ts --deterministic",
    "test:customer-directory:browser": "tsx --test src/browser/customer-directory.browser.test.ts",
    "test:callbacks": "tsx --test src/browser/callback-outcome.test.ts",
    "test:callbacks:browser": "tsx --test src/browser/callback-outcome.browser.test.ts",
    "placeholder": "tsx ./src/orchestrator/placeholder-orchestrator.ts",
    "run": "tsx ./src/cli/run-payment-automation.ts",
    "run:dry": "tsx ./src/cli/run-payment-automation.ts --target local-http --dry-run",
    "run:local:http:provider-matrix": "tsx ./src/cli/run-payment-automation.ts --target local-http",
    "run:docker:dev:http:provider-matrix": "tsx ./src/cli/run-payment-automation.ts --target docker-dev-http",
    "run:docker:dev:http": "tsx ./src/cli/run-payment-automation.ts --target docker-dev-http",
    "run:docker:dev:http:tests": "tsx ./src/cli/run-payment-automation.ts --target docker-dev-http-tests",
    "run:docker:dev:http:playwright": "tsx ./src/cli/run-payment-automation.ts --target docker-dev-http-playwright",
    "run:docker:dev:http:e2e-hook": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-phase10-docker-dev-e2e-hook.ps1",
    "xydatalabs-test-docker-local-e2e-dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-phase10-docker-dev-e2e-hook.ps1 -StabilizationDelaySeconds 60",
    "run:local:matrix": "tsx ./src/cli/run-local-matrix.ts",
    "run:local:http:playwright-matrix": "tsx ./src/cli/run-local-matrix.ts --target local-http --skip-verification",
    "run:local:https:playwright-matrix": "tsx ./src/cli/run-local-matrix.ts --target local-https --skip-verification",
    "run:local:http:playwright-sanity": "tsx ./src/cli/run-local-matrix.ts --target local-http --skip-verification --tenant-limit 1",
    "run:local:https:playwright-sanity": "tsx ./src/cli/run-local-matrix.ts --target local-https --skip-verification --tenant-limit 1",
    "run:local:matrix:dry": "tsx ./src/cli/run-local-matrix.ts --target local-http --dry-run",
    "run:docker:matrix": "tsx ./src/cli/run-docker-matrix.ts",
    "run:docker:dev:http:playwright-matrix": "tsx ./src/cli/run-docker-matrix.ts --target docker-dev-http",
    "run:docker:dev:https:playwright-matrix": "tsx ./src/cli/run-docker-matrix.ts --target docker-dev-https",
    "run:docker:stg:http:playwright-matrix": "tsx ./src/cli/run-docker-matrix.ts --target docker-stg-http",
    "run:docker:stg:https:playwright-matrix": "tsx ./src/cli/run-docker-matrix.ts --target docker-stg-https",
    "run:docker:prod:http:playwright-matrix": "tsx ./src/cli/run-docker-matrix.ts --target docker-prod-http",
    "run:docker:prod:https:playwright-matrix": "tsx ./src/cli/run-docker-matrix.ts --target docker-prod-https",
    "run:docker:dev:http:playwright-sanity": "tsx ./src/cli/run-docker-matrix.ts --target docker-dev-http --skip-verification --tenant-limit 1",
    "run:docker:dev:https:playwright-sanity": "tsx ./src/cli/run-docker-matrix.ts --target docker-dev-https --skip-verification --tenant-limit 1",
    "run:docker:stg:http:playwright-sanity": "tsx ./src/cli/run-docker-matrix.ts --target docker-stg-http --skip-verification --tenant-limit 1",
    "run:docker:stg:https:playwright-sanity": "tsx ./src/cli/run-docker-matrix.ts --target docker-stg-https --skip-verification --tenant-limit 1",
    "run:docker:prod:http:playwright-sanity": "tsx ./src/cli/run-docker-matrix.ts --target docker-prod-http --skip-verification --tenant-limit 1",
    "run:docker:prod:https:playwright-sanity": "tsx ./src/cli/run-docker-matrix.ts --target docker-prod-https --skip-verification --tenant-limit 1",
    "run:docker:matrix:dry": "tsx ./src/cli/run-docker-matrix.ts --dry-run",
    "run:azure:matrix": "tsx ./src/cli/run-azure-matrix.ts",
    "xydatalabs-test-azure-e2e-dev": "tsx ./src/cli/run-azure-matrix.ts --target azure-dev",
    "run:azure:matrix:dry": "tsx ./src/cli/run-azure-matrix.ts --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "js-yaml": "4.3.2",
    "playwright": "^1.59.1",
    "saxes": "6.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
