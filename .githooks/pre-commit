#!/bin/sh
# Simple pre-commit hook: scan for obvious secrets and prevent committing .env-like files
changed_files=$(git diff --cached --name-only)
# Block real env/key files and common AI artifacts, but allow checked-in example templates.
for f in $changed_files; do
  case "$f" in
    *.example)
      continue
      ;;
    *.pem|*.key|*.env|*/.env|*/.env.*)
      echo "Error: Attempting to commit env or key files. Remove them from the commit." >&2
      exit 1
      ;;
  esac
done
# Prevent committing prompt-runs and venv or large logs
echo "$changed_files" | grep -E "(^|/)(prompt-runs/|\.venv/|.*\.log$)" && {
  echo "Error: Attempting to commit runtime artifacts (prompt-runs/.venv/*.log). Remove them from the commit." >&2
  exit 1
}
# Block large generated files >5MB
for f in $changed_files; do
  if [ -f "$f" ]; then
    size=$(wc -c <"$f" )
    if [ "$size" -gt 5242880 ]; then
      echo "Error: Attempting to commit large file $f ($size bytes)." >&2
      exit 1
    fi
  fi
done
exit 0
