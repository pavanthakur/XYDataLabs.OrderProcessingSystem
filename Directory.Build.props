<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1062;CA1303;CS1573;EF1002;S2933;S2971;S3267;S6931;S6932;S6960</WarningsNotAsErrors>
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)Resources\BuildConfiguration\CodeAnalysis.ruleset</CodeAnalysisRuleSet>
    <!-- Docker-specific properties to prevent Windows Principal errors -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerUsePrincipal>false</DockerUsePrincipal>
    <DockerfileRunEnvironmentFiles></DockerfileRunEnvironmentFiles>
  </PropertyGroup>

  <!-- Roslyn analyzers — applied globally to all projects (build-time only, never shipped) -->
  <!-- Versions managed centrally in Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>